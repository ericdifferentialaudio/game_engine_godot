{
  "id": "zork",
  "_comment": "Per-game screen definition. Window POSITIONS are fixed here; window SIZES are the player's, adjusted by dragging the dividers and remembered in user://ui_layout.cfg. Variants are picked at startup from the real viewport aspect ratio: the best match is the highest min_aspect the viewport still satisfies.",

  "variants": [
    {
      "id": "wide",
      "min_aspect": 1.4,
      "_comment": "Ordinary landscape monitor: art over prose on the left, party over status on the right.",
      "root": {
        "orientation": "horizontal",
        "ratio": 0.68,
        "children": [
          {
            "orientation": "vertical",
            "ratio": 0.45,
            "children": [
              { "role": "scene", "type": "graphics", "title": "View",
                "min_size": [240, 140], "keep_aspect": true },
              { "role": "dialogue", "type": "text", "title": "Narration",
                "min_size": [320, 200], "max_lines": 500 }
            ]
          },
          {
            "orientation": "vertical",
            "ratio": 0.4,
            "children": [
              { "role": "party", "type": "units", "title": "Party",
                "min_size": [180, 120], "primary_stat": "health" },
              { "role": "status", "type": "icon_text", "title": "Carried",
                "min_size": [180, 120] },
              { "role": "log", "type": "icon_text", "title": "Recent",
                "min_size": [180, 90], "newest_first": true, "max_entries": 20 }
            ]
          }
        ]
      }
    },

    {
      "id": "tall",
      "min_aspect": 0.0,
      "_comment": "Narrow or portrait window: one column, prose given the most room, no map.",
      "root": {
        "orientation": "vertical",
        "ratio": 0.3,
        "children": [
          { "role": "scene", "type": "graphics", "title": "View",
            "min_size": [200, 120] },
          { "role": "dialogue", "type": "text", "title": "Narration",
            "min_size": [260, 220], "max_lines": 500 },
          { "role": "status", "type": "icon_text", "title": "Carried",
            "min_size": [200, 100] }
        ]
      }
    }
  ]
}
