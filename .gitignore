
# Chaos forge: regression history and raw harness logs are build artifacts.
# latest.json / *.jsonl are regenerated on every run; history.sqlite is a local
# cache used to classify NEW vs REGRESSION vs FLAKE.
tools/regressions/*.jsonl
tools/regressions/*.log
tools/regressions/history.sqlite
tools/regressions/latest.json

# Godot 4+ specific ignores (each project root: core/, game_api/isometric/, game_api/fps/)
.godot/
**/.godot/
.import/
**/.import/
export_presets.cfg
**/export_presets.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/

# System/editor specific
.DS_Store
Thumbs.db

# IDE
# .vscode/ is intentionally tracked: each engine layer ships editor settings
# (JSON-schema bindings for the data files, launch/task configs) that came from
# the upstream engines and are useful to everyone working on the repo.
# Machine-local overrides belong in .vscode/*.local.json instead.
.vscode/*.local.json
.idea/

# Local Godot executable paths (per machine; copy godot.local.example.json)
godot.local.json

# Claude Code: .claude/ is intentionally tracked (shared settings, agents,
# skills, hooks). Per-machine overrides and session state are not.
.claude/settings.local.json
.claude/*.local.json

# Python bytecode from the shared tools (core/tools/, games/*/tools/)
__pycache__/
*.pyc

# --- Binary art assets: NOT tracked -------------------------------------------
# This repo is text: code, data, design docs. Generated art is large, churns
# constantly and is never diffed, so it lives on disk (and in whatever asset
# store you use) rather than in git history. games/aevum/graphics alone was
# 3.0 GB across 3,254 files - roughly 99.8% of the repository - against ~3.5 MB
# of everything that is actually reviewable.
#
# The files are still on your disk; they are simply not committed. See
# docs/ASSETS.md for where they live and how to regenerate them.
games/*/graphics/
*.glb
*.gltf
*.fbx
*.blend
*.blend1
*.psd
*.tga
*.exr

# --- Ink compiler toolchain: NOT tracked ----------------------------------
# tools/inklecate/ used to be committed so a fresh clone had the Ink compiler
# out of the box, but inklecate.exe alone is ~59 MB - too large to keep in git
# history. The files still live on disk; they are simply not committed.
# See tools/inklecate/README.md for how to obtain/restore them.
tools/inklecate/*.exe
tools/inklecate/*.dll

# Scratch/debug output
_*.log

# Build/export output
build/
export/
*.log
