{
  "_comment": [
    "Generic place archetypes shipped with the framework. Games reference these",
    "with \"extends\" and override only what differs:",
    "  {\"id\": \"hollowmere\", \"extends\": \"village\", \"owner\": \"greywood\"}",
    "Nothing here is mandatory. A game may extend an archetype, extend another",
    "archetype of its own, invent a brand-new category, or ignore this file",
    "entirely. Dictionaries deep-merge on override; arrays replace."
  ],
  "places": [
    {
      "id": "village",
      "category": "village",
      "display_name": "Village",
      "description": "A small farming settlement.",
      "population": 200,
      "yields": {"food": 1},
      "interactions": [{"kind": "dialogue", "dialogue": "villager_generic"}]
    },
    {
      "id": "town",
      "extends": "village",
      "category": "town",
      "display_name": "Town",
      "population": 2000,
      "yields": {"food": 2, "gold": 1},
      "interactions": [
        {"kind": "shop", "shop": "general_goods"},
        {"kind": "dialogue", "dialogue": "townsfolk_generic"}
      ]
    },
    {
      "id": "city",
