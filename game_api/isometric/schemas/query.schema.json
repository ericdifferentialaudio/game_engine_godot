{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "query.schema.json",
  "title": "IntelQuery",
  "description": "Declarative knowledge/world-state predicate evaluated for a holder faction. Exactly one key.",
  "type": "object",
  "minProperties": 0,
  "properties": {
    "has": { "type": "string" },
    "min_reliability": { "type": "number", "minimum": 0, "maximum": 1 },
    "allow_stale": { "type": "boolean" },
    "max_age": { "type": "number", "minimum": 0 },
    "subject": { "type": "string" },
    "tag": { "type": "string" },
    "scope": { "enum": ["global", "region", "tile", "site", "unit", "faction", "item"] },
    "category": { "type": "string" },
    "count": { "type": "integer", "minimum": 1 },
    "fact": { "type": "array", "minItems": 3, "maxItems": 3 },
    "provenance": { "type": "array", "prefixItems": [{ "type": "string" }, { "enum": ["observed", "told", "read", "traded", "stolen", "spread", "derived", "scripted"] }], "minItems": 2, "maxItems": 2 },
    "source": { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 2 },
    "contradicted": { "type": "string" },
    "flag": { "type": "string" },
    "faction_flag": { "type": "string" },
    "resource": { "type": "array", "prefixItems": [{ "type": "string" }, { "enum": [">=", ">", "<=", "<", "==", "=", "!="] }, { "type": "number" }], "minItems": 3, "maxItems": 3 },
    "turn": { "type": "array", "prefixItems": [{ "enum": [">=", ">", "<=", "<", "==", "=", "!="] }, { "type": "number" }], "minItems": 2, "maxItems": 2 },
    "era": { "type": "string" },
    "owns_site": { "type": "string" },
    "unit_count": { "type": "array", "prefixItems": [{ "type": "string" }, { "enum": [">=", ">", "<=", "<", "==", "=", "!="] }, { "type": "number" }], "minItems": 3, "maxItems": 3 },
    "stance": { "type": "array", "prefixItems": [{ "type": "string" }, { "enum": ["war", "hostile", "peace", "friendly", "allied"] }], "minItems": 2, "maxItems": 2 },
    "all": { "type": "array", "items": { "$ref": "query.schema.json" } },
    "any": { "type": "array", "items": { "$ref": "query.schema.json" } },
    "not": { "$ref": "query.schema.json" }
  },
  "additionalProperties": false
}
