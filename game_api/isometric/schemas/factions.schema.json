{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "factions.schema.json",
  "title": "Factions",
  "type": "object",
  "required": ["factions"],
  "properties": {
    "factions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "display_name": { "type": "string" },
          "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "control": { "enum": ["human", "ai", "neutral", "hostile"] },
          "turn_order": { "type": "integer" },
          "starting_units": { "type": "array", "items": { "anyOf": [
            { "type": "string" },
            { "type": "object", "required": ["unit"], "properties": { "unit": { "type": "string" }, "count": { "type": "integer", "minimum": 1 } } } ] } },
          "start": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
          "resources": { "type": "object", "additionalProperties": { "type": "number" } },
          "claims_start_territory": { "type": "boolean" },
          "stances": { "type": "object", "additionalProperties": { "enum": ["war", "hostile", "peace", "friendly", "allied"] } },
          "default_stance": { "enum": ["war", "hostile", "peace", "friendly", "allied"] },
          "trade_partners": { "type": "array", "items": { "type": "string" } },
          "ai": { "type": "object", "properties": { "profile": { "type": "string" } } },
          "starting_intel": { "type": "array", "items": { "type": "string" } },
          "starting_items": { "type": "object", "additionalProperties": { "type": "integer" } },
          "tags": { "type": "array", "items": { "type": "string" } },
          "metadata": { "type": "object" }
        }
      }
    }
  }
}
