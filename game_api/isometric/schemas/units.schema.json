{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "units.schema.json",
  "title": "Units (heroes, units, NPCs, monsters, structures) + ability catalog",
  "type": "object",
  "required": ["units"],
  "properties": {
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "display_name": { "type": "string" },
          "description": { "type": "string" },
          "kind": { "enum": ["hero", "unit", "npc", "monster", "structure"] },
          "visual": { "type": "string" },
          "portrait": { "type": "string" },
          "stats": { "type": "object", "additionalProperties": { "type": "number" } },
          "movement": { "type": "object", "properties": {
            "domain": { "enum": ["land", "sea", "air"] },
            "ignore_terrain": { "type": "boolean" },
            "uses_roads": { "type": "boolean" },
            "terrain_costs": { "type": "object", "additionalProperties": { "type": "number" } },
            "impassable": { "type": "array", "items": { "type": "string" } } } },
          "abilities": { "type": "array", "items": { "type": "string" } },
          "equipment_slots": { "type": "array", "items": { "type": "string" } },
          "tags": { "type": "array", "items": { "type": "string" } },
          "cost": { "type": "object", "additionalProperties": { "type": "number" } },
          "upkeep": { "type": "object", "additionalProperties": { "type": "number" } },
          "ai_profile": { "type": "string" },
          "aggression": { "type": "number", "minimum": 0, "maximum": 1 },
          "loot": { "type": "array", "items": { "type": "object", "required": ["item"], "properties": {
            "item": { "type": "string" }, "chance": { "type": "number", "minimum": 0, "maximum": 1 }, "count": { "type": "integer" } } } },
          "xp_value": { "type": "integer", "minimum": 0 },
          "intel_profile": { "type": "object", "properties": {
            "on_sight": { "type": "array", "items": { "type": "string" } },
            "carries": { "type": "array", "items": { "type": "string" } },
            "on_defeat": { "type": "array", "items": { "type": "string" } },
            "on_combat": { "type": "array", "items": { "type": "string" } },
            "leak_chance": { "type": "number", "minimum": 0, "maximum": 1 } } },
          "dialogue": { "type": "object" },
          "shop": { "type": "object" },
          "schedule": { "type": "array", "items": { "type": "object" } },
          "level_curve": { "type": "object", "properties": {
            "base_xp": { "type": "integer" }, "growth": { "type": "number" },
            "per_level": { "type": "object", "additionalProperties": { "type": "number" } } } },
          "starting_items": { "type": "array" },
          "can_capture": { "type": "boolean" },
          "blocks_tile": { "type": "boolean" },
          "metadata": { "type": "object" }
        }
      }
    },
    "abilities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "display_name": { "type": "string" },
          "cost_ap": { "type": "number", "minimum": 0 },
          "cooldown": { "type": "integer", "minimum": 0 },
          "target": { "enum": ["self", "tile", "unit", "enemy", "ally"] },
          "range": { "type": "integer", "minimum": 0 },
          "requires": { "$ref": "query.schema.json" },
          "effects": { "type": "array", "items": { "$ref": "interaction.schema.json" } }
        }
      }
    }
  }
}
