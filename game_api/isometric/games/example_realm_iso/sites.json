      "coord": [9, 7],
      "visual": "site.stairs",
      "interactions": [
        { "kind": "portal", "target_map": "sunken_crypt_2", "target_coord": [1, 1], "direction": "descend", "message": "Bone dust drifts up the stair." }
      ]
    },
    {
      "id": "ossuary_stairs_up",
      "map": "sunken_crypt_2",
      "display_name": "Stairs up",
      "category": "generic",
      "coord": [1, 1],
      "visual": "site.stairs",
      "interactions": [
        { "kind": "portal", "direction": "ascend", "target_map": "sunken_crypt_1", "target_coord": [9, 7] }
      ]
    },
    {
      "id": "ossuary",
      "map": "sunken_crypt_2",
      "display_name": "The Ossuary",
      "category": "dungeon",
      "coord": [7, 5],
      "visual": "site.shrine",
      "spawns": [{ "unit": "bone_warden", "faction": "wilds", "count": 1, "radius": 1 }],
      "interactions": [
        { "kind": "combat", "target": "nearest_enemy", "once": true,
          "on_victory": [ { "kind": "flag", "quest": { "id": "sunken_crypt", "stage": "cleared" }, "set_flags": ["crypt_cleared"] } ] },
        { "kind": "reward", "resources": { "gold": 120 }, "once": true, "requires": { "flag": "crypt_cleared" }, "message": "The warden's hoard is yours." }
      ]
    }
  ]
}
