{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "factions.schema.json",
  "title": "Factions",
  "type": "object",
  "required": ["factions"],
  "$defs": { "relation": { "enum": ["hostile", "unfriendly", "neutral", "friendly", "allied"] } },
  "properties": {
    "factions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "display_name"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "display_name": { "type": "string" },
          "description": { "type": "string" },
          "relations": { "type": "object", "additionalProperties": { "$ref": "#/$defs/relation" } },
          "default_relation": { "$ref": "#/$defs/relation" },
          "player_reputation": { "type": "integer" },
          "reputation_thresholds": {
            "type": "object",
            "properties": {
              "hostile": { "type": "integer" }, "unfriendly": { "type": "integer" },
              "friendly": { "type": "integer" }, "allied": { "type": "integer" }
            }
          },
          "attack_on_sight_below": { "$ref": "#/$defs/relation" },
          "price_modifiers": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } },
          "tags": { "type": "array", "items": { "type": "string" } },
          "metadata": { "type": "object" }
        },
        "additionalProperties": false
      }
    }
  }
}
