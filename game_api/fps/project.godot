; Engine configuration file.

config_version=5

[application]

config/name="fps"
config/description="First-person 3D engine API layer built on the shared game_core platform."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg", "res://addons/game_core/plugin.cfg")

[autoload]

CoreContext="*res://addons/game_core/core_context.gd"
CoreRegistry="*res://addons/game_core/managers/core_registry.gd"
CoreIntel="*res://addons/game_core/managers/core_intel.gd"
VirtueSystem="*res://addons/game_core/managers/virtue_system.gd"
WorldStateManager="*res://addons/game_core/managers/world_state_manager.gd"
DialogueManager="*res://addons/game_core/managers/dialogue_manager.gd"
AIHeuristicManager="*res://addons/game_core/managers/ai_heuristic_manager.gd"
EventBus="*res://autoloads/event_bus.gd"
GameClock="*res://autoloads/game_clock.gd"
DefinitionRegistry="*res://autoloads/definition_registry.gd"
AssetRegistry="*res://autoloads/asset_registry.gd"
GameManager="*res://autoloads/game_manager.gd"
MapManager="*res://autoloads/map_manager.gd"
IntelRegistry="*res://autoloads/intel_registry.gd"
SaveManager="*res://autoloads/save_manager.gd"

[rendering]

renderer/rendering_method="forward_plus"

