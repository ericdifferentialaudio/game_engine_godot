; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="IntelForge Engine"
config/description="Framework for first-person, information/intel-focused fantasy games."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://core/event_bus.gd"
GameClock="*res://core/game_clock.gd"
DefinitionRegistry="*res://core/definition_registry.gd"
AssetRegistry="*res://core/asset_registry.gd"
GameManager="*res://core/game_manager.gd"
MapManager="*res://core/map_manager.gd"
IntelRegistry="*res://core/intel_registry.gd"
SaveManager="*res://core/save_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

